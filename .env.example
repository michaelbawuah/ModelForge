MODELFORGE_ENV=development
MODELFORGE_PUBLIC_BASE_URL=
MODELFORGE_WORKERS=1
MODELFORGE_RUN_MIGRATIONS=false
MODELFORGE_DB_STARTUP_ATTEMPTS=30
MODELFORGE_DB_STARTUP_DELAY_SECONDS=1
MODELFORGE_FORWARDED_ALLOW_IPS=127.0.0.1
PORT=8000
DATABASE_URL=mysql+pymysql://modelforge:modelforge_dev@127.0.0.1:3306/modelforge
MODEL_ARTIFACT_BACKEND=local
MODEL_ARTIFACT_ROOT=.modelforge/artifacts
MODEL_ARTIFACT_CACHE_ROOT=.modelforge/cache/artifacts
MODEL_ARTIFACT_S3_BUCKET=
MODEL_ARTIFACT_S3_PREFIX=modelforge
MODEL_ARTIFACT_S3_ENDPOINT=
MODELFORGE_AUTH_MODE=disabled
MODELFORGE_OIDC_ISSUER=
MODELFORGE_OIDC_AUDIENCE=
MODELFORGE_OIDC_JWKS_URL=
MODELFORGE_OIDC_AUTHORIZATION_URL=
MODELFORGE_OIDC_TOKEN_URL=
MODELFORGE_OIDC_CLIENT_ID=
MODELFORGE_OIDC_CLIENT_SECRET=
MODELFORGE_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
MODELFORGE_OIDC_SCOPE=openid profile email
MODELFORGE_SESSION_COOKIE_SECURE=true
MODELFORGE_SESSION_TTL_HOURS=12
MODELFORGE_TRUSTED_HOSTS=*
MODELFORGE_CORS_ORIGINS=
MODELFORGE_MAX_REQUEST_BYTES=1073741824
MODELFORGE_METRICS_TOKEN=
MODELFORGE_EXTERNAL_RUNTIMES={"go-linear":{"name":"modelforge-go-runtime","base_url":"http://127.0.0.1:8090","timeout_seconds":2.0}}

MODELFORGE_RUNTIME_TOKEN=modelforge_dev_runtime_token
