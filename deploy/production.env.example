# ModelForge production configuration template.
# Copy into your cloud secret/config system. Never commit real secret values.

MODELFORGE_ENV=production
PORT=8000
MODELFORGE_WORKERS=2
MODELFORGE_RUN_MIGRATIONS=false
MODELFORGE_DB_STARTUP_ATTEMPTS=30
MODELFORGE_DB_STARTUP_DELAY_SECONDS=1
MODELFORGE_FORWARDED_ALLOW_IPS=127.0.0.1

# Managed MySQL. Store credentials in your cloud secret manager.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@MYSQL_HOST:3306/modelforge

# Immutable cloud artifact storage.
MODEL_ARTIFACT_BACKEND=s3
MODEL_ARTIFACT_S3_BUCKET=YOUR_BUCKET
MODEL_ARTIFACT_S3_PREFIX=modelforge
MODEL_ARTIFACT_S3_ENDPOINT=
MODEL_ARTIFACT_CACHE_ROOT=/tmp/modelforge-artifact-cache
AWS_REGION=us-east-1

# Public origin and HTTP boundary.
MODELFORGE_PUBLIC_BASE_URL=https://modelforge.example.com
MODELFORGE_TRUSTED_HOSTS=modelforge.example.com
MODELFORGE_CORS_ORIGINS=
MODELFORGE_MAX_REQUEST_BYTES=1073741824
MODELFORGE_SESSION_COOKIE_SECURE=true
MODELFORGE_SESSION_TTL_HOURS=12
MODELFORGE_METRICS_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# OIDC Authorization Code + PKCE.
MODELFORGE_AUTH_MODE=oidc
MODELFORGE_OIDC_ISSUER=https://YOUR_IDP/
MODELFORGE_OIDC_AUDIENCE=https://modelforge.example.com
MODELFORGE_OIDC_JWKS_URL=https://YOUR_IDP/.well-known/jwks.json
MODELFORGE_OIDC_AUTHORIZATION_URL=https://YOUR_IDP/authorize
MODELFORGE_OIDC_TOKEN_URL=https://YOUR_IDP/oauth/token
MODELFORGE_OIDC_CLIENT_ID=YOUR_CLIENT_ID
MODELFORGE_OIDC_CLIENT_SECRET=
MODELFORGE_OIDC_REDIRECT_URI=https://modelforge.example.com/auth/callback
MODELFORGE_OIDC_SCOPE=openid profile email

# External runtimes remain framework-neutral. auth_token_env names a separate
# secret environment variable rather than embedding the secret in JSON.
MODELFORGE_EXTERNAL_RUNTIMES={"go-linear":{"name":"modelforge-go-runtime","base_url":"http://go-runtime.internal:8090","timeout_seconds":2.0,"max_retries":2,"retry_backoff_seconds":0.05,"circuit_failure_threshold":3,"circuit_reset_seconds":30.0,"auth_token_env":"MODELFORGE_RUNTIME_TOKEN"}}
MODELFORGE_RUNTIME_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
